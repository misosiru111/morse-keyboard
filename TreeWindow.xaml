<Window x:Class="MorseKeyboard.TreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MorseKeyboard"
        Title="Morse Keyboard"
        Width="350" Height="570" MinWidth="200" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True">

    <!-- The whole window is a drag handle; buttons and the resize grip handle their own clicks. -->
    <!-- Colors, fonts and decorations come from the active Theme (see TreeWindow.ApplyTheme). -->
    <Border x:Name="FrameBorder"
            MouseLeftButtonDown="Frame_MouseLeftButtonDown"
            MouseMove="Frame_MouseMove"
            MouseLeftButtonUp="Frame_MouseLeftButtonUp"
            LostMouseCapture="Frame_LostMouseCapture">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="ToggleButton" Style="{StaticResource PillButton}" Click="Toggle_Click"
                        ToolTip="モールス入力 ON/OFF (Ctrl+Alt+M)">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="ON" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="SpeedText" FontSize="12" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <Border x:Name="PracticeBadge" Background="#2A3A4A" CornerRadius="8" Padding="7,1"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="前面のアプリには入力しません（設定で切り替え）">
                    <TextBlock Text="練習" Foreground="#9FD8FF" FontSize="11" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="HeaderRight" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="設定" />
                <Button x:Name="HideButton" Style="{StaticResource IconButton}" Content="&#xE921;" Click="Hide_Click"
                        ToolTip="隠す（タスクトレイのアイコンで再表示）" />
            </StackPanel>

            <!-- Everything below scales with the window. -->
            <Viewbox Grid.Row="1" Stretch="Uniform" VerticalAlignment="Top" Margin="10,0,10,14">
                <StackPanel x:Name="ContentRoot" Width="680" IsHitTestVisible="False">
                    <local:MorseTreeCanvas x:Name="Tree" />
                    <local:DigitPanel x:Name="Digits" Margin="0,4,0,0" />

                    <!-- Current code, candidate letter, and what has been typed.
                         Panel style: one bordered box. Tape style: paper tape on the left, a glass window on the right. -->
                    <Border x:Name="Strip" Margin="6,14,6,0" BorderThickness="1" Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="WindowColumn" Width="110" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Tape">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel x:Name="CodeSymbols" Orientation="Horizontal" Height="36" />
                                    <TextBlock x:Name="HistoryText" FontSize="28" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Column="1">
                                <ContentControl x:Name="WindowArt" Focusable="False" />
                                <TextBlock x:Name="CandidateText" FontSize="76"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Viewbox>

            <!-- Theme decoration over the frame (screws, mounting holes). -->
            <ContentControl x:Name="FrameOverlay" Grid.RowSpan="2" IsHitTestVisible="False" Focusable="False" />
        </Grid>
    </Border>
</Window>
