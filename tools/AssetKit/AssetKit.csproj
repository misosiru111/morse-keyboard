<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generates starter theme artwork (PNG) for the app. See Program.cs for how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MorseKeyboard.csproj" />
  </ItemGroup>

</Project>
