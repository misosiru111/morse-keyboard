<Window x:Class="MorseKeyboard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Morse Keyboard の設定"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8,4,8,8" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="70" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <GroupBox Header="タイミング">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="速度 (WPM)" />
                <DockPanel>
                    <TextBlock x:Name="WpmText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="WpmSlider" Minimum="5" Maximum="40" TickFrequency="1"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>

                <TextBlock Style="{StaticResource Caption}" Text="長点とみなす押下時間（短点の何倍以上か）" />
                <DockPanel>
                    <TextBlock x:Name="DahText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="DahSlider" Minimum="1.5" Maximum="3" TickFrequency="0.1"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>

                <TextBlock Style="{StaticResource Caption}" Text="文字を確定するまでの間（標準は短点 3 個分）" />
                <DockPanel>
                    <TextBlock x:Name="LetterGapText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="LetterGapSlider" Minimum="2" Maximum="12" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>

                <TextBlock Style="{StaticResource Caption}" Text="単語を区切るまでの間（標準は短点 7 個分）" />
                <DockPanel>
                    <TextBlock x:Name="WordGapText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="WordGapSlider" Minimum="3" Maximum="24" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>

                <TextBlock x:Name="TimingSummary" Foreground="#666" Margin="0,6,0,0" TextWrapping="Wrap" />
                <CheckBox x:Name="AutoSpaceCheck" Content="単語の区切りで空白を自動入力する" Click="OnCheckChanged" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="入力">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="電鍵にするキー" />
                <ComboBox x:Name="KeyerCombo" SelectionChanged="OnSelectionChanged" />
                <CheckBox x:Name="SendToAppCheck" Click="OnCheckChanged"
                          Content="前面のアプリに文字を入力する（オフにすると練習専用）" />
                <CheckBox x:Name="UpperCaseCheck" Content="英字を大文字で入力する" Click="OnCheckChanged" />
                <CheckBox x:Name="KeystrokeCheck" Click="OnCheckChanged">
                    <TextBlock TextWrapping="Wrap">
                        キー入力として送る（IME を通すので、日本語入力 ON ならローマ字で日本語が打てます。
                        単語区切りの空白は自動入力しないので、空白・変換はスペースキー、確定は Enter で）
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="サイドトーン（押している間の音）">
            <StackPanel>
                <CheckBox x:Name="SidetoneCheck" Content="音を鳴らす" Click="OnCheckChanged" />
                <TextBlock Style="{StaticResource Caption}" Text="周波数" />
                <DockPanel>
                    <TextBlock x:Name="FrequencyText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="FrequencySlider" Minimum="300" Maximum="1200" TickFrequency="10"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}" Text="音量" />
                <DockPanel>
                    <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="表示・起動">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="デザイン" />
                <ComboBox x:Name="ThemeCombo" SelectionChanged="OnSelectionChanged" />
                <TextBlock Style="{StaticResource Caption}" Text="ウィンドウの不透明度" />
                <DockPanel>
                    <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Style="{StaticResource Value}" />
                    <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" TickFrequency="0.05"
                            IsSnapToTickEnabled="True" ValueChanged="OnSliderChanged" />
                </DockPanel>
                <CheckBox x:Name="StartEnabledCheck" Content="起動時にモールス入力を ON にする" Click="OnCheckChanged" />
            </StackPanel>
        </GroupBox>

        <TextBlock TextWrapping="Wrap" Foreground="#555">
            ON/OFF の切り替えは Ctrl + Alt + M。ON の間は選んだキーが電鍵になります。
            電鍵をスペースにした場合も、Shift・Ctrl・Alt と一緒に押したスペースはふだんどおり入力されます。
        </TextBlock>

        <DockPanel Margin="0,14,0,0" LastChildFill="False">
            <Button Content="初期値に戻す" Padding="12,4" Click="Reset_Click" />
            <Button Content="閉じる" Padding="24,4" DockPanel.Dock="Right" IsDefault="True" Click="Close_Click" />
        </DockPanel>
    </StackPanel>
</Window>
